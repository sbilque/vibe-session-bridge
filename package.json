{
  "name": "vibe-session-bridge",
  "displayName": "Mistral Vibe – Session Target (ACP bridge)",
  "description": "Expose l'agent ACP de Mistral Vibe (vibe-acp) comme Session Target natif du Chat VS Code via l'API proposée chatSessionsProvider.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.115.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatReferenceBinaryData"
  ],
  "contributes": {
    "chatSessions": [
      {
        "type": "mistral-vibe",
        "name": "vibe",
        "displayName": "Mistral Vibe",
        "description": "Agent Mistral Vibe via Agent Client Protocol (vibe-acp)",
        "welcomeTitle": "Mistral Vibe",
        "welcomeMessage": "Agent de code Mistral, exécuté localement via ACP",
        "inputPlaceholder": "Demandez une tâche à Mistral Vibe, # pour ajouter du contexte",
        "when": "config.vibeBridge.enabled",
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsImageAttachments": true
        },
        "icon": "$(sparkle)",
        "commands": [
          {
            "name": "help",
            "description": "Commandes et raccourcis disponibles"
          },
          {
            "name": "compact",
            "description": "Résumer l'historique (instructions facultatives)"
          },
          {
            "name": "reload",
            "description": "Recharger configuration, instructions et skills"
          },
          {
            "name": "log",
            "description": "Chemin du dossier de journaux de la session"
          },
          {
            "name": "mcp",
            "description": "État OAuth des serveurs MCP"
          },
          {
            "name": "teleport",
            "description": "Poursuivre la session dans Vibe Code Web"
          },
          {
            "name": "retry",
            "description": "Relancer la dernière requête"
          },
          {
            "name": "data-retention",
            "description": "Informations sur la conservation des données"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Mistral Vibe Session Bridge",
      "properties": {
        "vibeBridge.enabled": {
          "type": "boolean",
          "default": true
        },
        "vibeBridge.command": {
          "type": "string",
          "default": "vibe-acp",
          "description": "Exécutable ACP de Mistral Vibe (entrypoint 'vibe-acp' du package mistral-vibe). Chemin absolu recommandé sur macOS."
        },
        "vibeBridge.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "vibeBridge.env": {
          "type": "object",
          "default": {},
          "description": "Variables d'environnement additionnelles. Laisser vide pour utiliser ~/.vibe/.env."
        },
        "vibeBridge.terminal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Annonce la capacité ACP 'terminal' : Vibe exécute alors ses commandes shell via VS Code."
        },
        "vibeBridge.terminal.reveal": {
          "type": "string",
          "enum": [
            "onCreate",
            "never"
          ],
          "default": "onCreate",
          "description": "Affiche chaque commande de l'agent dans un terminal VS Code (miroir lecture seule, Ctrl+C pour arrêter)."
        },
        "vibeBridge.elicitation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Annonce la capacité ACP elicitation.form : les questions de Vibe (outil ask_user_question) s'affichent dans un questionCarousel."
        }
      }
    },
    "commands": [
      {
        "command": "vibeBridge.signIn",
        "title": "Mistral Vibe: Se connecter (abonnement)"
      },
      {
        "command": "vibeBridge.restart",
        "title": "Mistral Vibe: Redémarrer l'agent ACP"
      },
      {
        "command": "vibeBridge.showLog",
        "title": "Mistral Vibe: Afficher les journaux ACP"
      },
      {
        "command": "vibeBridge.continueIn",
        "title": "Mistral Vibe: Continuer dans…",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vibeBridge.continueInVibe",
        "title": "Mistral Vibe: Continuer dans Mistral Vibe (sélection ou fichier)"
      },
      {
        "command": "vibeBridge.sessions.rename",
        "title": "Renommer",
        "icon": "$(edit)",
        "category": "Mistral Vibe"
      },
      {
        "command": "vibeBridge.sessions.delete",
        "title": "Supprimer",
        "icon": "$(close)",
        "category": "Mistral Vibe"
      },
      {
        "command": "vibeBridge.signOut",
        "title": "Mistral Vibe: Se déconnecter"
      }
    ],
    "menus": {
      "chat/chatSessions": [
        {
          "command": "vibeBridge.continueIn",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@1"
        },
        {
          "command": "vibeBridge.sessions.rename",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@4"
        },
        {
          "command": "vibeBridge.sessions.delete",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@10"
        }
      ],
      "editor/context": [
        {
          "command": "vibeBridge.continueInVibe",
          "when": "config.vibeBridge.enabled",
          "group": "z_vibe"
        }
      ]
    }
  },
  "scripts": {
    "dts": "npx @vscode/dts dev",
    "check": "tsc -p . --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/vscode-stub.ts --outdir=dist/test --out-extension:.js=.mjs --log-level=warning && node dist/test/terminals.test.mjs && node dist/test/elicitation.test.mjs",
    "test:integration": "esbuild test/integration/vibe.integration.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/integration/vscode-host.ts --outfile=dist/test/vibe.integration.test.mjs --log-level=warning && node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs && IT_HARNESS=legacy node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs",
    "test:integration:mistral": "esbuild test/integration/vibe.integration.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/integration/vscode-host.ts --outfile=dist/test/vibe.integration.test.mjs --log-level=warning && VIBE_IT_MISTRAL=1 node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.115.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sbilque/vibe-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/sbilque/vibe-session-bridge/issues"
  },
  "homepage": "https://github.com/sbilque/vibe-session-bridge#readme"
}