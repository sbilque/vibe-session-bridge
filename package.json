{
  "name": "vibe-session-bridge",
  "displayName": "Mistral Vibe – Session Target (ACP bridge)",
  "description": "%ext.description%",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.115.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatReferenceBinaryData"
  ],
  "contributes": {
    "chatSessions": [
      {
        "type": "mistral-vibe",
        "name": "vibe",
        "displayName": "%session.displayName%",
        "description": "%session.description%",
        "welcomeTitle": "%session.welcomeTitle%",
        "welcomeMessage": "%session.welcomeMessage%",
        "inputPlaceholder": "%session.inputPlaceholder%",
        "when": "config.vibeBridge.enabled",
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsImageAttachments": true
        },
        "icon": "$(sparkle)",
        "commands": [
          {
            "name": "help",
            "description": "%cmd.help%"
          },
          {
            "name": "compact",
            "description": "%cmd.compact%"
          },
          {
            "name": "reload",
            "description": "%cmd.reload%"
          },
          {
            "name": "log",
            "description": "%cmd.log%"
          },
          {
            "name": "mcp",
            "description": "%cmd.mcp%"
          },
          {
            "name": "teleport",
            "description": "%cmd.teleport%"
          },
          {
            "name": "retry",
            "description": "%cmd.retry%"
          },
          {
            "name": "data-retention",
            "description": "%cmd.data-retention%"
          }
        ]
      }
    ],
    "configuration": {
      "title": "%conf.title%",
      "properties": {
        "vibeBridge.enabled": {
          "type": "boolean",
          "default": true
        },
        "vibeBridge.command": {
          "type": "string",
          "default": "vibe-acp",
          "description": "%conf.command.description%"
        },
        "vibeBridge.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "vibeBridge.env": {
          "type": "object",
          "default": {},
          "description": "%conf.env.description%"
        },
        "vibeBridge.terminal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%conf.terminal.enabled.description%"
        },
        "vibeBridge.terminal.reveal": {
          "type": "string",
          "enum": [
            "onCreate",
            "never"
          ],
          "default": "onCreate",
          "description": "%conf.terminal.reveal.description%"
        },
        "vibeBridge.elicitation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%conf.elicitation.enabled.description%"
        }
      }
    },
    "commands": [
      {
        "command": "vibeBridge.signIn",
        "title": "%cmd.signIn%"
      },
      {
        "command": "vibeBridge.restart",
        "title": "%cmd.restart%"
      },
      {
        "command": "vibeBridge.showLog",
        "title": "%cmd.showLog%"
      },
      {
        "command": "vibeBridge.continueIn",
        "title": "%cmd.continueIn%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vibeBridge.continueInVibe",
        "title": "%cmd.continueInVibe%"
      },
      {
        "command": "vibeBridge.sessions.rename",
        "title": "%cmd.rename%",
        "icon": "$(edit)",
        "category": "Mistral Vibe"
      },
      {
        "command": "vibeBridge.sessions.delete",
        "title": "%cmd.delete%",
        "icon": "$(close)",
        "category": "Mistral Vibe"
      },
      {
        "command": "vibeBridge.signOut",
        "title": "%cmd.signOut%"
      }
    ],
    "menus": {
      "chat/chatSessions": [
        {
          "command": "vibeBridge.continueIn",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@1"
        },
        {
          "command": "vibeBridge.sessions.rename",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@4"
        },
        {
          "command": "vibeBridge.sessions.delete",
          "when": "chatSessionType == mistral-vibe",
          "group": "1_edit@10"
        }
      ],
      "editor/context": [
        {
          "command": "vibeBridge.continueInVibe",
          "when": "config.vibeBridge.enabled",
          "group": "z_vibe"
        }
      ]
    }
  },
  "scripts": {
    "dts": "npx @vscode/dts dev",
    "check": "tsc -p . --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/vscode-stub.ts --outdir=dist/test --out-extension:.js=.mjs --log-level=warning && node dist/test/terminals.test.mjs && node dist/test/elicitation.test.mjs && node dist/test/l10n.test.mjs",
    "test:integration": "esbuild test/integration/vibe.integration.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/integration/vscode-host.ts --outfile=dist/test/vibe.integration.test.mjs --log-level=warning && node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs && IT_HARNESS=legacy node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs",
    "test:integration:mistral": "esbuild test/integration/vibe.integration.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/integration/vscode-host.ts --outfile=dist/test/vibe.integration.test.mjs --log-level=warning && VIBE_IT_MISTRAL=1 node --test --test-concurrency=1 dist/test/vibe.integration.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.115.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sbilque/vibe-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/sbilque/vibe-session-bridge/issues"
  },
  "homepage": "https://github.com/sbilque/vibe-session-bridge#readme",
  "l10n": "./l10n"
}